# --- GitHub (for the cron job to commit updated data files) ---
# Fine-grained Personal Access Token scoped to just this repo,
# "Contents: Read and write" permission only.
# NOT the same thing as "Claude connected to GitHub" in the chat UI —
# this is a separate credential the deployed app uses at runtime.
GITHUB_TOKEN=
GITHUB_OWNER=RifqiFachruradzi
GITHUB_REPO=coros-running-dashboard
GITHUB_BRANCH=main

# --- Cron security ---
# Any random string. Vercel automatically sends it as
# `Authorization: Bearer <value>` when invoking scheduled cron requests;
# this route checks it matches so no one else can trigger a sync.
# Required in production — without it the sync route rejects every request.
CRON_SECRET=

# --- Dashboard ---
# Login for the whole dashboard (/login). Set these in Vercel only — this repo
# is public, so never commit real values. Required in production: without a
# password the dashboard stays locked. Local `npm run dev` skips login when
# the password is empty.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
# Long random string that signs the session cookie.
AUTH_SECRET=
# Weekly running distance goal in km (default 20).
WEEKLY_TARGET_KM=

# --- Vercel KV (Upstash Redis) ---
# Auto-injected when you enable the "Vercel KV" storage integration on the
# project — no need to set these by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Pelatih AI (9Router, OpenAI-compatible) ---
# Base URL ending in /v1, the API key from 9Router's "Endpoint & Key" page,
# and a model or combo name that 9Router serves.
COACH_LLM_BASE_URL=https://9router.38-9-46-94.sslip.io/v1
COACH_LLM_API_KEY=
COACH_LLM_MODEL=
# Optional: a different model for /chat (defaults to COACH_LLM_MODEL).
COACH_CHAT_MODEL=
